# ==========================================
# Multimodal AI Chatbot - Configuration
# ==========================================

# Backend & Server Settings
APP_NAME="Multimodal AI Chatbot"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1
BACKEND_URL=http://127.0.0.1:8000

# Database Configuration (PostgreSQL with optional pgvector)
# Example: postgresql://postgres:postgres@localhost:5432/multimodal_chatbot
# Fallback for lightweight local testing when PostgreSQL is not installed:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multimodal_chatbot

# AI Model Provider Selection ("openai" or "gemini")
AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_TTS_MODEL=tts-1
OPENAI_WHISPER_MODEL=whisper-1

# Google Gemini Configuration (Optional / Alternative)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Web Search Configuration (Tavily API with automatic DuckDuckGo fallback)
TAVILY_API_KEY=your_tavily_api_key_here

# Storage & Upload Limits
UPLOAD_DIR=./uploads
GENERATED_MEDIA_DIR=./generated_media
MAX_UPLOAD_SIZE_MB=10

